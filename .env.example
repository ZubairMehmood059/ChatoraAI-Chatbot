# ==============================================================================
# Chatora AI - Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# PRIVILEGED SERVER-SIDE SECRETS (Python FastAPI Backend)
# Never expose these in frontend code or in VITE_ variables!
# ------------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Google Gemini AI generation and streaming.
# Obtain a free-tier key from https://aistudio.google.com/
GEMINI_API_KEY=""

# GEMINI_MODEL: Free-tier / low-latency Gemini model (default matches backend config)
GEMINI_MODEL="gemini-3.5-flash-lite"

# SUPABASE_URL: Your Supabase Project API URL used by the backend to verify JWT tokens.
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Privileged secret key used ONLY on the backend.
# Supports traditional JWT service_role keys or newer Supabase secret keys (sb_secret_...).
# NEVER expose this key to the frontend or prefix with VITE_!
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_ANON_KEY: Optional legacy-compatible public key used as the backend apikey header.
# This alone does not enable backend bearer verification; configure a server secret above.
SUPABASE_ANON_KEY=""

# DATABASE_URL: Asynchronous PostgreSQL database connection URL for Supabase.
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# In development, leave blank; `npm run dev` selects isolated local SQLite storage.
DATABASE_URL=""

# PORT & HOST: Server listening configuration
PORT="8000"
HOST="0.0.0.0"

# CORS_ORIGINS: Comma-separated allowed origins (e.g., your Netlify domain)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://chatora.ai,https://chatora-ai.netlify.app"

# ------------------------------------------------------------------------------
# CLIENT-SIDE PUBLIC VARIABLES (Exposed to the browser via Vite bundles)
# ------------------------------------------------------------------------------

# VITE_SUPABASE_URL: Your Supabase Project API URL for client-side Auth SDK.
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Publishable key for client-side Auth SDK (protected by RLS).
# Supports legacy anon JWTs or newer Supabase publishable keys (sb_publishable_...).
VITE_SUPABASE_ANON_KEY=""

# VITE_API_URL: Base URL for backend API endpoints.
# - Leave empty ("") when using same-origin proxy or Netlify API rewrites.
# - Set to "https://api.yourdomain.com" if backend FastAPI is hosted on a separate domain.
VITE_API_URL=""
