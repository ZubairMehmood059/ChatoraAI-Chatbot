# ==============================================================================
# Chatora AI - Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# PRIVILEGED SERVER-SIDE SECRETS (Never expose in frontend or VITE_ variables)
# ------------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI streaming and assistant capabilities.
# Kept strictly server-side in Node/Express runtime.
GEMINI_API_KEY="your-gemini-api-key-here"

# SUPABASE_URL: Supabase Project API URL used by server to verify JWT tokens.
# Example: https://xyzcompany.supabase.co
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_ANON_KEY: Used by server to verify tokens.
# Prefer SUPABASE_SERVICE_ROLE_KEY on backend for elevated verification.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# PORT: Server listening port (default 3000)
PORT="3000"

# ------------------------------------------------------------------------------
# CLIENT-SIDE PUBLIC VARIABLES (Exposed to the browser via Vite bundles)
# ------------------------------------------------------------------------------

# VITE_SUPABASE_URL: Your Supabase Project API URL for client-side Auth SDK.
# Safe for public client consumption.
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public Anon Key for client-side Auth SDK.
# Safe for public client consumption (protected by Supabase Row-Level Security).
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# VITE_API_URL: Base URL for backend API endpoints.
# - Leave empty ("") when using same-origin proxy, local dev, or Netlify API rewrites.
# - Set to "https://api.yourdomain.com" if backend Express is hosted on a separate domain.
VITE_API_URL=""

# APP_URL: Optional canonical URL where the app is hosted (e.g. https://chatora.ai)
APP_URL=""
